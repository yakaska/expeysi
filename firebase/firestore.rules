rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /families/{familyId} {
      // Создать семью может любой вошедший пользователь (он станет первым членом).
      // В создаваемом документе требуется поле name: отсекает неявное создание
      // пустого родителя при записи члена в несуществующую семью — «присоединение»
      // по несуществующему коду не должно порождать фиктивные семьи.
      allow create: if isSignedIn() && request.resource.data.name is string;
      // Проверка кода перед присоединением: вошедший пользователь может убедиться,
      // что семья существует (только get одного документа; list всех семей —
      // по-прежнему только для участников).
      allow get: if isSignedIn();
      allow read, update, delete: if isMember(familyId);

      match /members/{uid} {
        allow read: if isMember(familyId);
        // Присоединение по коду: зная familyId, можно создать только СВОЙ документ члена.
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if isMember(familyId) && request.auth.uid == uid;
      }

      match /balances/{balanceId} {
        allow read, write: if isMember(familyId);
      }

      match /accounts/{accountId} {
        allow read, write: if isMember(familyId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(familyId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isMember(familyId);
      }
    }
  }
}
